# ============================================================
# Telegram Archive & Migration Suite — environment configuration
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ============================================================

# --- PostgreSQL -------------------------------------------------
POSTGRES_USER=archiver
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=telegram_archiver

# --- Redis ------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Application ------------------------------------------------
# Built from the above inside docker-compose; for local dev:
# DATABASE_URL=postgresql+asyncpg://archiver:change-me-strong-password@localhost:5432/telegram_archiver
# (local default when unset: sqlite+aiosqlite:///./data/dev.db)
EXPORTS_DIR=/data/exports
DEBUG=false
ALLOWED_ORIGINS=http://localhost

# --- Dashboard authentication ------------------------------------
# Admin user is seeded on first boot (Phase 2).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
# Generate a strong random value, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# --- Telegram session encryption ----------------------------------
# Generate with:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt Telethon session strings at rest. LOSING THIS KEY = sessions unusable.
SESSION_ENCRYPTION_KEY=

# --- Export engine tuning (conservative by default) ---------------
# Messages fetched per second (paced to avoid FloodWait/limitations).
EXPORT_MSGS_PER_SEC=1.0
# Burst allowance for short bursts (Telethon internal pacing).
EXPORT_BURST=5
# Checkpoint every N messages (crash-resume granularity).
CHECKPOINT_EVERY=250
# Max concurrent media downloads per export.
MEDIA_CONCURRENCY=2
# Max concurrent Telegram sessions across all accounts.
MAX_CONCURRENT_SESSIONS=5
