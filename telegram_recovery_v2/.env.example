# ============================================================
# Telegram Recovery v2 — environment configuration
# Copy to `.env` and adjust. NEVER commit the real `.env`.
#
# Auth requirement: one Telethon session per actor.
#   SOURCE ACCOUNT (A) = the account that still holds the history.
#   TARGET ACCOUNT (B) = the account recovering its lost copy.
# The recovery peer is the A<->B private chat (or a group both are in).
#
# Interactive user login (python -m recovery_v2.login_accounts) uses:
# ============================================================

# --- Telegram app credentials (my.telegram.org) ---------------------------
# api_id / api_hash for the app you log in with (normal USER accounts,
# NOT bots). Used by `python -m recovery_v2.login_accounts`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- SOURCE ACCOUNT A (the source of truth) ---------------------
# Get api_id / api_hash at https://my.telegram.org (API development tools).
RECOVERY_API_ID_A=
RECOVERY_API_HASH_A=
RECOVERY_PHONE_A=

# Session for A. Either a saved export or the path to a session string.
# Prefer a session FILE (protect its permissions); fall back to inline string.
#   RECOVERY_SESSION_A_STRING=<exported session string>
#   RECOVERY_SESSION_A_FILE=/secure/path/session_a.txt
RECOVERY_SESSION_A_FILE=
RECOVERY_SESSION_A_STRING=

# --- TARGET ACCOUNT B (the recovery target) ----------------------
RECOVERY_API_ID_B=
RECOVERY_API_HASH_B=
RECOVERY_PHONE_B=

RECOVERY_SESSION_B_FILE=
RECOVERY_SESSION_B_STRING=

# --- Recovery peer -------------------------------------------------
# The chat being recovered (the private A<->B chat by default).
# Accepts an @username, a numeric chat/user id, or a phone number.
RECOVERY_PEER=

# --- Run / artifact -------------------------------------------------
# Where run artifacts are written (source snapshot, archive, package,
# traces, mapping, reports). Each run gets its own sub-directory.
RECOVERY_RUN_DIR=./test_runs

# --- Pacing / safety -------------------------------------------------
# Source reads are paced to avoid FloodWait. Conservative by default.
RECOVERY_MSGS_PER_SEC=2.0
RECOVERY_BURST=5

# --- Media ------------------------------------------------------------
# Set 1 to download source media bytes into the archive.
RECOVERY_DOWNLOAD_MEDIA=1
# SHA-256 checkpoint file name used to resume interrupted downloads.
RECOVERY_MEDIA_RESUME=1