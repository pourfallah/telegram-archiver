# Recovery v2 — copy to .env and fill in.
# Never commit the real .env or session files.

# Telegram API credentials (from my.telegram.org). One pair is enough if both
# sessions were created with the same api_id; per-account overrides supported.
RECOVERY_API_ID=
RECOVERY_API_HASH=

# Account A (source of truth). Session string or path to a session file.
RECOVERY_ACCOUNT_A_PHONE=+989394430100
RECOVERY_ACCOUNT_A_SESSION=
RECOVERY_ACCOUNT_A_API_ID=
RECOVERY_ACCOUNT_A_API_HASH=

# Account B (recovery target).
RECOVERY_ACCOUNT_B_PHONE=+5511991966422
RECOVERY_ACCOUNT_B_SESSION=
RECOVERY_ACCOUNT_B_API_ID=
RECOVERY_ACCOUNT_B_API_HASH=

# Where run artifacts are written (default: ./test_runs relative to package root)
RECOVERY_RUNS_DIR=

# Optional: proxy for Telegram connections, e.g. socks5://127.0.0.1:1080
RECOVERY_PROXY=
